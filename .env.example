# Copy to .env and fill in. .env is gitignored and must never be committed.
# Used only by scripts/send_brief.py, which can reach exactly one address: yours.

BRAIN_SMTP_HOST=smtp.gmail.com
BRAIN_SMTP_PORT=587
BRAIN_SMTP_USER=you@gmail.com

# Gmail: this is an App Password (16 chars), NOT your account password.
# Create one at myaccount.google.com > Security > 2-Step Verification > App passwords.
BRAIN_SMTP_PASS=

# Where the weekly brief goes. The only destination this project can reach.
BRAIN_EMAIL_TO=you@gmail.com
